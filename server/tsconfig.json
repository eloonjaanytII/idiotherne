{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": ".",             
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,            
    "checkJs": false,          
    "noEmit": false            
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}